# Examples only. Do not commit a real environment file or print secret values.
# Runtime may use PgBouncer; migrations MUST use a direct PostgreSQL connection.
DATABASE_URL=postgres://smartcindy:CHANGE_ME@127.0.0.1:6432/smartcindy
MIGRATION_DATABASE_URL=postgres://smartcindy:CHANGE_ME@127.0.0.1:5432/smartcindy
LISTEN_ADDR=127.0.0.1:8787
# Empty/missing keys make the corresponding capability unavailable (503 before acceptance).
DEEPSEEK_API_KEY=
BFL_API_KEY=
# Provision with password on protected stdin; no password argument.
# SMARTCINDY_PROVISION_PASSWORD may be supplied by a protected operator environment.
